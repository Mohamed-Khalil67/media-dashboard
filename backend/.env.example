DATABASE_URL="postgresql://user:pass@localhost:5432/media_dashboard"
JWT_SECRET="generate-a-long-random-string"
ENCRYPTION_KEY="32-byte-hex-key-for-token-encryption"
FRONTEND_URL="http://localhost:4200"
PORT=3000
# Email that should always be admin. On startup, the server upserts an
# AllowedEmail row for them and promotes their User row to role=admin.
BOOTSTRAP_ADMIN_EMAIL=""

# Sync only runs for connections whose owner was active in the last N hours.
ACTIVITY_WINDOW_HOURS=4
# Retention sweeper (runs daily on RETENTION_CRON; defaults to 03:00 local).
SYNC_RUN_RETENTION_DAYS=7
INSIGHT_RETENTION_DAYS=30
RETENTION_CRON="0 3 * * *"

FB_APP_ID=""
FB_APP_SECRET=""
FB_REDIRECT_URI="http://localhost:3000/api/facebook/callback"

TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/tiktok/callback"

SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_REDIRECT_URI="http://localhost:3000/api/shopify/callback"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""
