# Local dev: `docker compose up -d` at the repo root starts Postgres on 5433
# with these credentials. Then run `npx prisma migrate deploy` in backend/.
DATABASE_URL="postgresql://media:media@localhost:5433/media_dashboard"
# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate-a-long-random-string"     # signs the OAuth state during Connect Facebook
ENCRYPTION_KEY="32-byte-hex-key-for-token-encryption"  # exactly 64 hex chars; encrypts platform tokens at rest
FRONTEND_URL="http://localhost:4200"
PORT=3000

# Firebase Admin SDK — verifies the ID tokens the Angular app gets from
# Firebase Auth (backend never sees passwords). Provide exactly one of:
#   FIREBASE_SERVICE_ACCOUNT_JSON — the service-account key, minified to one line
#   GOOGLE_APPLICATION_CREDENTIALS — absolute path to the key file (ADC)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Background sync: every 2 minutes by default, only for users active within the
# activity window (default 5 minutes). A per-connection cooldown prevents
# back-to-back syncs from spamming the platforms.
SYNC_CRON="*/2 * * * *"
ACTIVITY_WINDOW_MINUTES=5
SYNC_COOLDOWN_SECONDS=90

# Retention sweeper (daily). Keeps SyncRun history bounded.
RETENTION_CRON="0 3 * * *"
SYNC_RUN_RETENTION_DAYS=7
INSIGHT_RETENTION_DAYS=30

# Platform-app credentials are supplied PER CONNECTION by each user via the UI
# (Connections page → "Connect Facebook" / "Connect Shopify" → modal asks for
# their own App ID / Secret + historical date range). No platform credentials
# live in this file.
#
# Optional: override the Graph API version used by Facebook sync.
# FB_GRAPH_VERSION="v21.0"
# Optional: override the Shopify Admin API version.
# SHOPIFY_API_VERSION="2025-01"
