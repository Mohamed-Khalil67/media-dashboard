// Prisma schema — Phase 1
// Multi-tenant data model: every Connection and downstream row is owned by a User.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  firebaseUid        String?           @unique
  passwordHash       String? // legacy; kept during Firebase migration window
  pendingMigration   Boolean           @default(false)
  name               String?
  createdAt          DateTime          @default(now())
  plan               String            @default("trial") // trial | starter | pro | agency
  role               String            @default("client") // admin | media_buyer | client
  disabled           Boolean           @default(false)
  stripeCustomerId   String?
  activeWorkspaceId  String?
  lastActiveAt       DateTime? // bumped on every authenticated request; drives idle-detection for syncs
  connections        Connection[]
  alerts             AlertRule[]
  workspaceMembers   WorkspaceMember[]
  identities         Identity[]

  @@index([lastActiveAt])
}

// Audit trail of hard-deleted accounts. We write a row here in the same
// transaction as `user.delete`, so even though the User row is gone we can
// still answer "who deleted whom, when, and what was wiped along with them".
// Survives the cascade because it has no FK to User.
model DeletionLog {
  id               String   @id @default(cuid())
  deletedUserId    String // the cuid that USED to be the User.id
  deletedUserEmail String
  deletedUserName  String?
  deletedUserRole  String // admin | media_buyer | client
  deletedBy        String // admin User.id at the time of deletion
  deletedByEmail   String // captured at-delete so it remains readable if the admin is later deleted too
  deletedAt        DateTime @default(now())
  cascadeSummary   Json // { connections, campaigns, insights, syncRuns, shopifyOrders, alertRules, workspaceMembers }

  @@index([deletedAt(sort: Desc)])
  @@index([deletedByEmail])
}

// Strict invite-only allowlist. requireAuth rejects any Firebase-authenticated
// email that isn't present here. Manage via `npm run allow:add` / Prisma Studio.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique // stored lowercased
  note      String?
  addedBy   String?  // userId of the admin who added it, nullable for bootstrap rows
  createdAt DateTime @default(now())
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  createdAt   DateTime          @default(now())
  members     WorkspaceMember[]
  connections Connection[]
  alertRules  AlertRule[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member") // "owner" | "member"
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Identity {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // "facebook" | "google"
  providerId String
  email      String?

  @@unique([provider, providerId])
  @@index([userId])
}

model Connection {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform       String // facebook | tiktok | shopify
  accountId      String // ad account id or shop domain
  accountName    String?
  accessToken    String // ENCRYPTED at rest
  refreshToken   String? // ENCRYPTED at rest
  tokenExpiresAt DateTime?
  status         String         @default("active") // active | expired | revoked
  createdAt      DateTime       @default(now())
  lastSyncAt     DateTime?
  lastSyncOk     Boolean?
  lastSyncError  String?
  campaigns      Campaign[]
  shopifyOrders  ShopifyOrder[]
  syncRuns       SyncRun[]

  @@unique([userId, platform, accountId])
  @@index([userId])
  @@index([workspaceId])
}

model SyncRun {
  id            String     @id @default(cuid())
  connectionId  String
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  ok            Boolean?
  error         String? // truncated to 500 chars by sync.job
  campaignCount Int?
  insightCount  Int?

  @@index([connectionId, startedAt(sort: Desc)])
}

model Campaign {
  id                 String     @id @default(cuid())
  connectionId       String
  connection         Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId         String // platform's campaign id
  name               String
  status             String
  createdAtPlatform  DateTime? // when the campaign was created on the ad platform itself
  raw                Json? // full API payload (JSONB)
  insights           Insight[]

  @@unique([connectionId, externalId])
  @@index([connectionId])
}

model Insight {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  purchases   Int      @default(0)
  revenue     Float    @default(0)
  frequency   Float    @default(0)
  raw         Json?

  @@unique([campaignId, date])
  @@index([date])
  @@index([campaignId])
}

model ShopifyOrder {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId   String
  totalPrice   Float
  createdAt    DateTime
  raw          Json?

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([createdAt])
}

model AlertRule {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      String // roas | frequency | budget_pace
  operator    String // lt | gt
  threshold   Float
  enabled     Boolean    @default(true)

  @@index([userId])
  @@index([workspaceId])
}
